#requests is a module that allows the code to make HTTP requests, like GET and POST requests
#This allows it to work with APIs and retrieve data from them.
#For this code, it's used to send a GET request to the Zippopotam.us API to get longitude and latitude based on country and postal code.
import requests

#This is the base URL for the Zippopotam.us API. 
#The "country" and "postal-code" parts that are supposed to be at the end of the URL will be replaced with the actual country code and postal code when the user inputs them.
#This is what the full url should look like: "http://api.zippopotam.us/country/postal-code"
base_url = "http://api.zippopotam.us/"


#This function will take in a country code and postal code, create the full URL, and send a GET request to the API.
def get_location(country, postal_code):
    url = f"{base_url}{country}/{postal_code}"
    response = requests.get(url)

    #This if statement will check if the request was successful (Status Code 200).
    #If it was successful, it will parse the JSON response and print the longitude, latitude, city, and state. 
    #If it was not successful, it will print an error message with the status code.
    if response.status_code == 200:
        data = response.json() 
        city = data['places'][0]['place name']
        state = data['places'][0]['state']
        longitude = data['places'][0]['longitude']
        latitude = data['places'][0]['latitude']
        print(f"City: {city}, State: {state}")
        print(f"Longitude: {longitude}, Latitude: {latitude}")

    else:
        print(f"Error: {response.status_code}")

    return response



response = get_location("US", "54724")


